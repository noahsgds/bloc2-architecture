# Copier en .env et remplacer chaque "change-me" (lettres et chiffres uniquement).
# Ce fichier .env n'est jamais versionné : il contient les secrets.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
PIPELINE_PASSWORD=change-me
API_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
